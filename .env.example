# Cloudflare Turnstile keys for the contact form's bot/captcha protection.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Add your production domain(s) to the widget, then copy the keys below.

# Public site key - safe to expose in client-side HTML.
PUBLIC_TURNSTILE_SITE_KEY=

# Secret key - server-side only, never commit or expose this.
TURNSTILE_SECRET_KEY=

# NOTE: the contact form currently delivers email via FormSubmit.co
# (https://formsubmit.co/shelleyliucounsellingpractice@gmail.com), which needs
# no additional keys here. Turnstile above only gates/verifies the submission
# before it is forwarded to FormSubmit.
