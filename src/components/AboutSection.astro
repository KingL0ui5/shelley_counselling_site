---
---

<section id="about" class="py-20 md:py-28 bg-white border-y border-stone-200/80">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
			
			<!-- Image & Caption Column (approximately a quarter width) -->
			<div class="lg:col-span-4 xl:col-span-3 space-y-4">
				<figure class="relative mx-auto max-w-[260px] sm:max-w-[280px] lg:max-w-none space-y-3.5">
					<!-- Clean Portrait Image -->
					<div class="aspect-[4/5] rounded-3xl bg-stone-100 border border-stone-200 overflow-hidden shadow-md">
						<img 
							src="/shelley_liu.jpeg" 
							alt="Shelley Liu - MBACP Registered Counsellor" 
							class="w-full h-full object-cover object-top"
						/>
					</div>
					
					<!-- Compact Caption Box -->
					<figcaption class="p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 shadow-xs space-y-1">
						<div class="flex items-center justify-between gap-2 flex-wrap">
							<h3 class="font-serif text-lg font-medium text-stone-900">Shelley Liu</h3>
						</div>
						<p class="text-[11px] text-stone-600 font-light flex items-center gap-1.5">
							<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
							MBACP Registered Member
						</p>
					</figcaption>

					<!-- Professional Directory Links -->
					<div class="space-y-2 pt-1">
						<a 
							href="https://www.counselling-directory.org.uk/counsellors/shelley-liu" 
							target="_blank" 
							rel="noopener noreferrer"
							class="group flex items-center justify-between p-3 rounded-2xl bg-[#faf9f6] hover:bg-emerald-50/70 border border-stone-200/80 hover:border-emerald-300 transition-all duration-200 shadow-2xs"
						>
							<div class="flex items-center gap-2.5">
								<div class="w-7 h-7 rounded-xl bg-white border border-stone-200/70 flex items-center justify-center text-emerald-800 shadow-2xs group-hover:bg-[#5ad01f]/20 transition-colors">
									<svg class="w-4 h-4 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
									</svg>
								</div>
								<div>
									<div class="text-xs font-semibold text-stone-900 group-hover:text-emerald-950 transition-colors">
										Counselling Directory
									</div>
								</div>
							</div>
							<svg class="w-3.5 h-3.5 text-stone-400 group-hover:text-emerald-800 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>

						<a 
							href="https://www.bacp.co.uk/search/Register?q=shelley%20liu%20" 
							target="_blank" 
							rel="noopener noreferrer"
							class="group flex items-center justify-between p-3 rounded-2xl bg-[#faf9f6] hover:bg-emerald-50/70 border border-stone-200/80 hover:border-emerald-300 transition-all duration-200 shadow-2xs"
						>
							<div class="flex items-center gap-2.5">
								<div class="w-7 h-7 rounded-xl bg-white border border-stone-200/70 flex items-center justify-center text-emerald-800 shadow-2xs group-hover:bg-[#5ad01f]/20 transition-colors">
									<svg class="w-4 h-4 text-emerald-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
									</svg>
								</div>
								<div>
									<div class="text-xs font-semibold text-stone-900 group-hover:text-emerald-950 transition-colors">
										BACP Register
									</div>
								</div>
							</div>
							<svg class="w-3.5 h-3.5 text-stone-400 group-hover:text-emerald-800 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</div>
				</figure>
			</div>

			<!-- Text Column (remaining three quarters width) -->
			<div class="lg:col-span-8 xl:col-span-9 space-y-6">
				<div class="space-y-2">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						About Me
					</span>
					<h2 class="font-serif text-3xl sm:text-4xl text-stone-900 leading-tight">
						Compassionate, Person-Centred Support Tailored to You
					</h2>
				</div>

				<p class="text-stone-700 text-base sm:text-lg leading-relaxed font-light">
					Hello and welcome. I am a qualified, MBACP-registered counsellor providing one-to-one online therapy for adults across the UK. My practice is grounded in creating an approachable, down-to-earth, and trustworthy environment where you can speak openly without fear of judgment.
				</p>
				
				<p class="text-stone-700 text-base sm:text-lg leading-relaxed font-light">		
					I work relationally and collaboratively. I believe you are the expert of your own life; my role is not to give prescriptive advice or tell you what to do, but to help you untangle complex feelings, identify repetitive patterns, and discover new perspectives that empower you to make meaningful changes.
				</p>

				<!-- Credentials & Experience Grid -->
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
					<div class="p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 space-y-1.5 hover:border-emerald-200 transition-colors">
						<h4 class="font-semibold text-stone-900 text-sm flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f]"></span>
							Clinical Experience
						</h4>
						<p class="text-xs text-stone-600 leading-normal">
							Over 5 years supporting clients across NHS Talking Therapies and MIND counselling services.
						</p>
					</div>

					<div class="p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 space-y-1.5 hover:border-emerald-200 transition-colors">
						<h4 class="font-semibold text-stone-900 text-sm flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f]"></span>
							Specialist Training
						</h4>
						<p class="text-xs text-stone-600 leading-normal">
							Metanoia Institute Person-Centred Experiential Counselling for Depression (PCE-CfD).
						</p>
					</div>

					<div class="p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 space-y-1.5 hover:border-emerald-200 transition-colors">
						<h4 class="font-semibold text-stone-900 text-sm flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f]"></span>
							Corporate Insights
						</h4>
						<p class="text-xs text-stone-600 leading-normal">
							Professional background in finance, bringing lived understanding of high-pressure corporate workloads and burnout.
						</p>
					</div>

					<div class="p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 space-y-1.5 hover:border-emerald-200 transition-colors">
						<h4 class="font-semibold text-stone-900 text-sm flex items-center gap-2">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f]"></span>
							Professional Ethics
						</h4>
						<p class="text-xs text-stone-600 leading-normal">
							Continuous clinical supervision, ongoing professional development, and adherence to the BACP Ethical Framework.
						</p>
					</div>
				</div>

				<div class="pt-2">
					<a 
						href="#services" 
						class="inline-flex items-center text-sm font-semibold text-emerald-900 hover:text-emerald-950 gap-1.5 group"
					>
						Explore issues I can help you with
						<svg class="w-4 h-4 text-[#5ad01f] transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
				</div>
			</div>

		</div>
	</div>
</section>
