---
---

<section id="contact" class="py-12 sm:py-16 md:py-20 bg-white border-t border-stone-200/80">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
			
			<!-- Left Column: Titles, Email & Availability Disclaimer -->
			<div class="lg:col-span-5 space-y-5">
				<div class="space-y-2 sm:space-y-3">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						Get In Touch
					</span>
					<h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-stone-900 leading-snug sm:leading-tight">
						Take the First Step Today
					</h2>
					<p class="text-stone-600 text-base font-light leading-relaxed">
						Reaching out can feel like the hardest part. Whether you have specific questions or are ready to schedule an initial consultation, I am here to help.
					</p>
				</div>
				
				<div class="space-y-3 pt-1">
					<!-- Direct Email Enquiry (full width) -->
					<div class="w-full p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-[#faf9f6] border border-stone-200/80 space-y-1.5 shadow-2xs">
						<div class="text-xs sm:text-sm font-semibold text-stone-900">Direct Email Enquiry</div>
						<a href="mailto:shelleyliucounsellingpractice@gmail.com" class="text-sm sm:text-base font-medium text-emerald-900 hover:text-emerald-950 transition-colors break-all block">
							shelleyliucounsellingpractice@gmail.com
						</a>
						<div class="text-xs text-stone-500 font-light">Replies typically within 24–48 hours</div>
					</div>

					<!-- Telephone -->
					<div class="w-full p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-[#faf9f6] border border-stone-200/80 space-y-1.5 shadow-2xs">
						<div class="text-xs sm:text-sm font-semibold text-stone-900">Telephone</div>
						<a href="tel:+447434125934" class="text-sm sm:text-base font-medium text-emerald-900 hover:text-emerald-950 transition-colors block">
							+44 7434 125934
						</a>
					</div>

					<!-- In-Person Availability Disclaimer -->
					<div class="w-full p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-[#faf9f6] border border-stone-200/80 text-xs sm:text-sm text-stone-600 font-light flex items-start gap-2.5 shadow-2xs">
						<svg class="w-4 h-4 text-emerald-800 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<p class="leading-relaxed">
							<strong class="font-medium text-stone-800">Please note:</strong> All sessions are currently held online via Zoom. There is currently no availability for in-person sessions.
						</p>
					</div>
				</div>
			</div>

			<!-- Right Column: Contact Form Box -->
			<div class="lg:col-span-7">
				<div class="bg-[#faf9f6] border border-stone-200 rounded-2xl sm:rounded-3xl p-5 sm:p-7 md:p-8 shadow-2xs">
					
					<h3 class="font-serif text-xl sm:text-2xl font-normal text-stone-900 mb-1">Send a Message</h3>
					<p class="text-sm sm:text-base text-stone-600 font-light mb-1.5">
						Please fill in your details below and I will get back to you promptly.
					</p>
					<p class="text-xs text-stone-500 font-light mb-5 sm:mb-6">
						Fields marked with an asterisk (*) are required.
					</p>

					<form 
						id="contact-form" 
						action="https://formsubmit.co/shelleyliucounsellingpractice@gmail.com" 
						method="POST" 
						class="space-y-4"
					>
						<!-- FormSubmit Settings -->
						<input type="hidden" name="_subject" value="New Website Counselling Enquiry" />
						<input type="hidden" name="_template" value="table" />
						<input type="hidden" name="_captcha" value="false" />
						<input type="hidden" name="_next" id="form-next-url" value="/thank-you" />
						<!-- Anti-spam Honeypot -->
						<input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
							<div class="space-y-1.5">
								<label for="name" class="block text-xs sm:text-sm font-semibold text-stone-700">Full Name *</label>
								<input 
									type="text" 
									id="name" 
									name="name" 
									required 
									placeholder="e.g. Jane Doe"
									class="w-full px-3.5 sm:px-4 py-3 sm:py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all"
								/>
							</div>
							<div class="space-y-1.5">
								<label for="email" class="block text-xs sm:text-sm font-semibold text-stone-700">Email Address *</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									required 
									placeholder="e.g. jane@example.com"
									class="w-full px-3.5 sm:px-4 py-3 sm:py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all"
								/>
							</div>
						</div>

						<div class="space-y-1.5">
							<label for="message" class="block text-xs sm:text-sm font-semibold text-stone-700">How Can I Support You? *</label>
							<textarea 
								id="message" 
								name="message" 
								rows="4" 
								required 
								placeholder="Type message here..."
								class="w-full px-3.5 sm:px-4 py-3 sm:py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-base sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all resize-none"
							></textarea>
						</div>

						<!-- Consent Checkbox -->
						<div class="flex items-start gap-2.5">
							<input 
								type="checkbox" 
								id="consent" 
								name="consent" 
								value="Agreed to Privacy Policy and Terms and Conditions"
								required 
								class="mt-0.5 w-4 h-4 shrink-0 rounded border-stone-300 text-emerald-900 accent-emerald-900 focus:ring-2 focus:ring-emerald-700 cursor-pointer"
							/>
							<label for="consent" class="text-xs sm:text-sm text-stone-600 font-light leading-relaxed cursor-pointer">
								I have read and agree to the <a href="/privacy-policy" target="_blank" class="text-emerald-900 font-medium hover:underline">Privacy Policy</a> and <a href="/terms-and-conditions" target="_blank" class="text-emerald-900 font-medium hover:underline">Terms and Conditions</a> *
							</label>
						</div>

						<!-- Success Message -->
						<div id="form-success" class="hidden p-4 rounded-xl sm:rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs sm:text-sm font-light leading-relaxed flex items-start gap-2.5">
							<svg class="w-5 h-5 text-emerald-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<div>
								<p class="font-medium text-emerald-950">Thank you for reaching out.</p>
								<p>Your message has been sent successfully. Shelley will be in touch with you shortly.</p>
							</div>
						</div>

						<!-- Error Message -->
						<div id="form-error" class="hidden p-4 rounded-xl sm:rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 text-xs sm:text-sm font-light leading-relaxed flex items-start gap-2.5">
							<svg class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
							</svg>
							<div>
								<p class="font-medium text-amber-950">There was a problem sending your message.</p>
								<p>Please try again or email directly at <a href="mailto:shelleyliucounsellingpractice@gmail.com" class="underline font-normal text-emerald-900">shelleyliucounsellingpractice@gmail.com</a>.</p>
							</div>
						</div>

						<button 
							type="submit" 
							id="submit-btn"
							class="w-full py-3.5 sm:py-4 px-6 rounded-full bg-emerald-900 hover:bg-emerald-950 text-white font-medium text-base shadow-md hover:shadow-lg active:scale-[0.99] transition-all duration-200 disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
						>
							<span id="btn-text">Send Message</span>
							<svg id="btn-spinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</button>

						<p class="text-xs text-stone-500 font-light leading-relaxed">
							Please note that while this form is encrypted, standard email is not 100% secure. Please only share minimal information here. We will discuss your detailed circumstances safely during our first session.
						</p>
					</form>

				</div>
			</div>

		</div>

	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
	const btnText = document.getElementById('btn-text');
	const btnSpinner = document.getElementById('btn-spinner');
	const successBox = document.getElementById('form-success');
	const errorBox = document.getElementById('form-error');
	const nextInput = document.getElementById('form-next-url') as HTMLInputElement | null;

	// Populate absolute URL for FormSubmit fallback redirect
	if (nextInput && typeof window !== 'undefined') {
		nextInput.value = window.location.origin + '/thank-you';
	}

	// Flag check on page load (in case redirected with query parameters)
	if (typeof window !== 'undefined') {
		const urlParams = new URLSearchParams(window.location.search);
		if (urlParams.get('success') === 'true' || urlParams.get('submitted') === 'true') {
			if (successBox) {
				successBox.classList.remove('hidden');
				successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			}
		}
	}

	if (form && submitBtn && btnText && btnSpinner && successBox && errorBox) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			// Clear previous notifications & set loading state
			successBox.classList.add('hidden');
			errorBox.classList.add('hidden');
			submitBtn.disabled = true;
			btnText.textContent = 'Sending Message...';
			btnSpinner.classList.remove('hidden');

			try {
				const formData = new FormData(form);
				const rawAction = form.getAttribute('action') || 'https://formsubmit.co/ajax/shelleyliucounsellingpractice@gmail.com';
				const ajaxUrl = rawAction.includes('/ajax/') ? rawAction : rawAction.replace('formsubmit.co/', 'formsubmit.co/ajax/');

				const response = await fetch(ajaxUrl, {
					method: "POST",
					headers: {
						'Accept': 'application/json'
					},
					body: formData
				});

				const result = await response.json();

				if (response.ok && (result.success === "true" || result.success === true || result.message)) {
					// Route immediately to dedicated /thank-you page
					window.location.href = '/thank-you';
				} else {
					throw new Error(result.message || 'Form submission failed');
				}
			} catch (error) {
				console.error('AJAX submission failed, falling back to standard submission with _next redirect:', error);
				// If AJAX fetch is interrupted or fails, submit normally using _next redirect
				if (nextInput) {
					nextInput.value = window.location.origin + '/thank-you';
				}
				form.submit();
			}
		});
	}
</script>
