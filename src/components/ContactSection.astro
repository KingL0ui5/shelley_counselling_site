---
---

<section id="contact" class="py-20 md:py-28 bg-white border-t border-stone-200/80">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
			
			<!-- Left Column: Contact details & reassurance -->
			<div class="lg:col-span-5 space-y-6">
				<div class="space-y-3">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						Get In Touch
					</span>
					<h2 class="font-serif text-3xl sm:text-4xl text-stone-900 leading-tight">
						Take the First Step Today
					</h2>
					<p class="text-stone-600 text-sm font-light leading-relaxed">
						Reaching out can feel like the hardest part. Whether you have specific questions or are ready to schedule an initial consultation, I am here to help.
					</p>
				</div>

				<!-- Info Cards -->
				<div class="space-y-4 pt-2">
					<div class="flex items-start gap-4 p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 hover:border-emerald-200 transition-colors">
						<div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
							<svg class="w-5 h-5 text-[#5ad01f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</div>
						<div>
							<div class="text-xs font-semibold text-stone-900">Email Enquiry</div>
							<a href="mailto:info@shelleyliutherapy.co.uk" class="text-sm text-emerald-900 hover:text-emerald-950 font-medium break-all">
								info@shelleyliutherapy.co.uk
							</a>
							<div class="text-[11px] text-stone-500 mt-0.5">Replies typically within 24-48 business hours</div>
						</div>
					</div>

					<div class="flex items-start gap-4 p-4 rounded-2xl bg-[#faf9f6] border border-stone-200/80 hover:border-emerald-200 transition-colors">
						<div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0 border border-emerald-100">
							<svg class="w-5 h-5 text-[#5ad01f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
						</div>
						<div>
							<div class="text-xs font-semibold text-stone-900">Strict Confidentiality</div>
							<p class="text-xs text-stone-600 font-light mt-0.5">
								All communications are kept strictly confidential in compliance with GDPR and BACP data privacy standards.
							</p>
						</div>
					</div>
				</div>

				<div class="p-5 rounded-2xl bg-[#faf9f6] border border-stone-200 text-xs text-stone-600 font-light space-y-1">
					<span class="font-semibold text-stone-800">Initial 15-Minute Phone Call:</span>
					<p>We can arrange a brief informal call prior to booking your first video session to ensure we are a good fit for one another.</p>
				</div>
			</div>

			<!-- Right Column: Enquiry Form -->
			<div class="lg:col-span-7">
				<div class="bg-[#faf9f6] border border-stone-200 rounded-3xl p-6 sm:p-8 shadow-xs">
					
					<h3 class="font-serif text-2xl font-normal text-stone-900 mb-2">Send a Message</h3>
					<p class="text-xs sm:text-sm text-stone-600 font-light mb-6">
						Please fill in your details below and I will get back to you promptly.
					</p>

					<form id="contact-form" class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('form-success').classList.remove('hidden'); this.reset();">
						
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1.5">
								<label for="name" class="block text-xs font-semibold text-stone-700">Full Name *</label>
								<input 
									type="text" 
									id="name" 
									name="name" 
									required 
									placeholder="e.g. Jane Doe"
									class="w-full px-4 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all"
								/>
							</div>
							<div class="space-y-1.5">
								<label for="email" class="block text-xs font-semibold text-stone-700">Email Address *</label>
								<input 
									type="email" 
									id="email" 
									name="email" 
									required 
									placeholder="e.g. jane@example.com"
									class="w-full px-4 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all"
								/>
							</div>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1.5">
								<label for="phone" class="block text-xs font-semibold text-stone-700">Phone Number (Optional)</label>
								<input 
									type="tel" 
									id="phone" 
									name="phone" 
									placeholder="e.g. 07123 456789"
									class="w-full px-4 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all"
								/>
							</div>
							<div class="space-y-1.5">
								<label for="time-pref" class="block text-xs font-semibold text-stone-700">Preferred Session Time *</label>
								<select 
									id="time-pref" 
									name="time_pref" 
									class="w-full px-4 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all"
								>
									<option value="morning">Morning (9am – 12pm)</option>
									<option value="afternoon">Afternoon (12pm – 5pm)</option>
									<option value="evening">Evening (5pm – 8pm)</option>
									<option value="flexible">Flexible / Any Time</option>
								</select>
							</div>
						</div>

						<div class="space-y-1.5">
							<label for="message" class="block text-xs font-semibold text-stone-700">How Can I Support You? *</label>
							<textarea 
								id="message" 
								name="message" 
								rows="4" 
								required 
								placeholder="Briefly describe what brings you to counselling and any specific preferences..."
								class="w-full px-4 py-2.5 rounded-xl border border-stone-300 bg-white text-stone-900 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent transition-all resize-none"
							></textarea>
						</div>

						<div id="form-success" class="hidden p-4 rounded-xl bg-emerald-100 border border-emerald-300 text-emerald-950 text-xs font-medium">
							Thank you for reaching out! Your message has been sent. Shelley will be in touch with you shortly.
						</div>

						<button 
							type="submit" 
							class="w-full py-3.5 px-6 rounded-full bg-emerald-900 hover:bg-emerald-950 text-white font-medium text-sm shadow-md hover:shadow-lg transition-all duration-200"
						>
							Send Confidential Message
						</button>
					</form>

				</div>
			</div>

		</div>

	</div>
</section>
