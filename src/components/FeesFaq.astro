---
const faqs = [
	{
		q: 'How long are sessions and how often do we meet?',
		a: 'Individual counselling sessions are 50 minutes long and typically take place once a week at a regular, agreed-upon time. Consistency provides a reliable and grounded framework for therapeutic work.'
	},
	{
		q: 'How does online video therapy work?',
		a: 'Online therapy takes place via Zoom. Before each session, you will receive a private video link. All you need is a reliable internet connection and a confidential and private, quiet space where you feel comfortable to speak openly and cannot be overheard.'
	},
	{
		q: 'How many sessions will I need?',
		a: 'This depends entirely on you. Some clients benefit from short-term focused counselling (6 to 12 sessions) to address a specific life crisis or decision, while others prefer open-ended therapy to explore deeper patterns over time. This can be discussed during the first session.'
	},
	{
		q: 'Is everything we discuss confidential?',
		a: 'Yes. Confidentiality is paramount to the therapeutic relationship. All discussions adhere to the strict ethical guidelines of the British Association for Counselling and Psychotherapy (BACP), with standard legal and safeguarding exceptions which will be clearly explained during the first session.'
	},
	{
		q: 'What is your cancellation policy?',
		a: 'I operate a 24-hour cancellation policy. If you need to cancel or reschedule, please give at least 24 hours notice to avoid being charged the full session fee.'
	}
];
---

<section id="fees-faq" class="py-14 sm:py-20 md:py-28 bg-[#faf9f6]">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
			
			<!-- Left Column: Fees and Pricing -->
			<div class="lg:col-span-5 space-y-6 sm:space-y-8">
				<div class="space-y-2">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						Fees
					</span>
					<h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-stone-900 leading-snug sm:leading-tight">
						Fees and Sessions
					</h2>
				</div>

				<!-- Fee Breakdown Cards -->
				<div class="space-y-3.5 sm:space-y-4">
					<!-- Initial Intro Call -->
					<div class="p-4 sm:p-6 rounded-xl sm:rounded-2xl bg-white border border-stone-200/80 shadow-2xs space-y-2 hover:border-emerald-200 transition-colors">
						<div class="flex items-start sm:items-center justify-between gap-2 flex-wrap sm:flex-nowrap">
							<h3 class="font-serif font-medium text-stone-900 text-base sm:text-lg">Initial Consultation</h3>
							<span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-800 rounded-full font-semibold border border-emerald-100 shrink-0">Free • 15 Mins</span>
						</div>
						<p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">
							A free, informal phone or video conversation to discuss what brings you to counselling, answer any questions, and see if we are a good therapeutic fit.
						</p>
					</div>

					<!-- Standard Session -->
					<div class="p-4 sm:p-6 rounded-xl sm:rounded-2xl bg-white border border-stone-200/80 shadow-2xs space-y-2 hover:border-emerald-200 transition-colors">
						<div class="flex items-start sm:items-center justify-between gap-2 flex-wrap sm:flex-nowrap">
							<h3 class="font-serif font-medium text-stone-900 text-base sm:text-lg">Individual Session</h3>
							<span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-800 rounded-full font-semibold border border-emerald-100 shrink-0">£60 • 50 Mins</span>
						</div>
						<p class="text-sm sm:text-base text-stone-600 font-light leading-relaxed">
							One-to-one weekly online counselling session conducted via Zoom from the comfort and privacy of your own space. The first session is chargable.
						</p>
					</div>
				</div>

			</div>

			<!-- Right Column: FAQs Accordion -->
			<div class="lg:col-span-7 space-y-6">
				<div class="space-y-2">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						FAQ
					</span>
					<h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-stone-900 leading-snug sm:leading-tight">
						Frequently Asked Questions
					</h2>
				</div>

				<div class="space-y-3 sm:space-y-4 pt-1">
					{faqs.map((faq) => (
						<details class="group bg-white rounded-xl sm:rounded-2xl border border-stone-200/80 p-4 sm:p-5 open:shadow-sm open:border-emerald-300 transition-all duration-200">
							<summary class="flex justify-between items-center font-serif text-base sm:text-lg font-medium text-stone-900 cursor-pointer list-none select-none gap-3">
								<span>{faq.q}</span>
								<span class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-stone-500 group-open:rotate-180 group-open:bg-[#5ad01f]/20 group-open:text-emerald-900 transition-transform duration-200 shrink-0 text-xs">
									↓
								</span>
							</summary>
							<p class="mt-2.5 sm:mt-3 text-sm sm:text-base text-stone-600 font-light leading-relaxed border-t border-stone-100 pt-2.5 sm:pt-3">
								{faq.a}
							</p>
						</details>
					))}
				</div>
			</div>

		</div>

	</div>
</section>
