---
const faqs = [
	{
		q: 'How long are sessions and how often do we meet?',
		a: 'Individual counselling sessions are 50 minutes long and typically take place once a week at a regular, agreed-upon time. Consistency provides a reliable and grounded framework for therapeutic work.'
	},
	{
		q: 'How does online video therapy work?',
		a: 'Online therapy takes place via a secure, encrypted video platform. Before each session, you will receive a private video link. All you need is a reliable internet connection and a private, quiet space where you feel comfortable to speak openly.'
	},
	{
		q: 'How many sessions will I need?',
		a: 'This depends entirely on your personal goals. Some clients benefit from short-term focused counselling (6 to 12 sessions) to address a specific life crisis or decision, while others prefer open-ended therapy to explore deeper patterns over time.'
	},
	{
		q: 'Is everything we discuss confidential?',
		a: 'Yes. Confidentiality is paramount to the therapeutic relationship. All discussions adhere to the strict ethical guidelines of the British Association for Counselling and Psychotherapy (BACP), with standard legal and safeguarding exceptions which will be clearly explained.'
	},
	{
		q: 'What is your cancellation policy?',
		a: 'I operate a 48-hour cancellation policy. If you need to cancel or reschedule, please give at least 48 hours notice to avoid being charged the full session fee.'
	}
];
---

<section id="fees-faq" class="py-20 md:py-28 bg-[#faf9f6]">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
			
			<!-- Left Column: Online Therapy & Practical Details -->
			<div class="lg:col-span-5 space-y-8">
				<div class="space-y-3">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						Practical Details
					</span>
					<h2 class="font-serif text-3xl sm:text-4xl text-stone-900 leading-tight">
						Online Therapy &amp; Practical Info
					</h2>
					<p class="text-stone-600 text-sm font-light leading-relaxed">
						Convenient, accessible, and confidential therapy delivered remotely across the UK.
					</p>
				</div>

				<!-- Practical Info Cards -->
				<div class="space-y-4">
					<div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-xs space-y-2 hover:border-emerald-200 transition-colors">
						<div class="flex items-center justify-between">
							<h3 class="font-serif font-medium text-stone-900 text-lg">Secure Video Platform</h3>
							<span class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-800 rounded-full font-medium border border-emerald-100">Encrypted</span>
						</div>
						<p class="text-xs text-stone-600 font-light leading-relaxed">
							Conducted via a secure, private video link (Zoom/Google Meet) without the need for complicated software installation.
						</p>
					</div>

					<div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-xs space-y-2 hover:border-emerald-200 transition-colors">
						<div class="flex items-center justify-between">
							<h3 class="font-serif font-medium text-stone-900 text-lg">Accessible UK-Wide</h3>
							<span class="text-xs px-2.5 py-1 bg-stone-100 text-stone-700 rounded-full font-medium">UK-Wide</span>
						</div>
						<p class="text-xs text-stone-600 font-light leading-relaxed">
							Connect from the comfort, safety, and privacy of your own home or workspace anywhere across the UK, eliminating travel time and commute stress.
						</p>
					</div>

					<div class="p-6 rounded-2xl bg-white border border-stone-200/80 shadow-xs space-y-2 hover:border-emerald-200 transition-colors">
						<div class="flex items-center justify-between">
							<h3 class="font-serif font-medium text-stone-900 text-lg">Weekly 50-Min Slots</h3>
							<span class="text-xs px-2.5 py-1 bg-stone-100 text-stone-700 rounded-full font-medium">Regular</span>
						</div>
						<p class="text-xs text-stone-600 font-light leading-relaxed">
							A dedicated, recurring weekly appointment time reserved specifically for you to ensure therapeutic continuity.
						</p>
					</div>
				</div>

			</div>

			<!-- Right Column: FAQs Accordion -->
			<div class="lg:col-span-7 space-y-6">
				<div class="space-y-3">
					<span class="text-xs font-semibold tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
						Common Inquiries
					</span>
					<h2 class="font-serif text-3xl sm:text-4xl text-stone-900 leading-tight">
						Frequently Asked Questions
					</h2>
				</div>

				<div class="space-y-4 pt-2">
					{faqs.map((faq) => (
						<details class="group bg-white rounded-2xl border border-stone-200/80 p-5 open:shadow-md open:border-emerald-300 transition-all duration-200">
							<summary class="flex justify-between items-center font-serif text-base font-medium text-stone-900 cursor-pointer list-none select-none">
								<span>{faq.q}</span>
								<span class="ml-4 w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-stone-500 group-open:rotate-180 group-open:bg-[#5ad01f]/20 group-open:text-emerald-900 transition-all duration-200 shrink-0 text-sm">
									↓
								</span>
							</summary>
							<p class="mt-3 text-xs sm:text-sm text-stone-600 font-light leading-relaxed border-t border-stone-100 pt-3">
								{faq.a}
							</p>
						</details>
					))}
				</div>
			</div>

		</div>

	</div>
</section>
