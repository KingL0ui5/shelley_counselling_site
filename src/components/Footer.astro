---
const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 pt-16 pb-12 text-xs font-light border-t border-stone-800">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
		
		<div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
			
			<!-- Brand Info -->
			<div class="md:col-span-5 space-y-3">
				<div class="space-y-1">
					<h3 class="font-serif text-2xl text-white font-medium">Shelley Liu</h3>
					<p class="text-[#5ad01f] font-medium text-xs tracking-wider uppercase">Counselling Service • MBACP</p>
				</div>
				<p class="text-stone-400 text-xs leading-relaxed max-w-sm">
					Professional, confidential, person-centred counselling services provided online to clients throughout the UK.
				</p>
			</div>

			<!-- Navigation Links -->
			<div class="md:col-span-3 space-y-3">
				<h4 class="font-serif text-sm font-medium text-white tracking-wide">Quick Navigation</h4>
				<ul class="space-y-2 text-stone-400">
					<li><a href="#about" class="hover:text-[#5ad01f] transition-colors">About Shelley</a></li>
					<li><a href="#services" class="hover:text-[#5ad01f] transition-colors">Areas of Support</a></li>
					<li><a href="#how-it-works" class="hover:text-[#5ad01f] transition-colors">How Therapy Works</a></li>
					<li><a href="#fees-faq" class="hover:text-[#5ad01f] transition-colors">Fees &amp; FAQs</a></li>
					<li><a href="#contact" class="hover:text-[#5ad01f] transition-colors">Book Consultation</a></li>
					<li><a href="#crisis-support" class="text-amber-400 hover:text-amber-300 font-medium transition-colors">Emergency &amp; Crisis Support</a></li>
				</ul>
			</div>

			<!-- Therapy Format & Contact -->
			<div class="md:col-span-4 space-y-3">
				<h4 class="font-serif text-sm font-medium text-white tracking-wide">Therapy Format</h4>
				<ul class="space-y-2 text-stone-400 leading-normal">
					<li><strong class="text-stone-300">Online Therapy:</strong> Secure video sessions across the UK</li>
					<li><strong class="text-stone-300">Confidentiality:</strong> Private &amp; GDPR compliant</li>
					<li class="pt-2">
						<a href="mailto:info@shelleyliutherapy.co.uk" class="text-[#5ad01f] hover:underline">
							info@shelleyliutherapy.co.uk
						</a>
					</li>
				</ul>
			</div>

		</div>

		<!-- Bottom Copyright -->
		<div class="pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-stone-500">
			<div>
				© {currentYear} Shelley Liu Counselling Service. All rights reserved.
			</div>
		</div>

	</div>
</footer>
