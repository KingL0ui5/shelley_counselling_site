---
const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 pt-16 pb-12 text-xs font-light border-t border-stone-800">
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
		
		<div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start">
			
			<!-- Brand Info -->
			<div class="space-y-4">
				<div class="space-y-1">
					<h3 class="font-serif text-2xl text-white font-medium">Shelley Liu</h3>
					<p class="text-[#5ad01f] font-medium text-xs tracking-wider uppercase">Counselling Service • MBACP</p>
				</div>

				
				<!-- BACP Accreditation Badge (2x larger) -->
				<div class="pt-2">
					<a 
						href="https://www.bacp.co.uk/search/Register?q=shelley%20liu%20" 
						target="_blank" 
						rel="noopener noreferrer" 
						class="inline-block p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-white shadow-md hover:shadow-lg transition-all duration-200 group border border-stone-200"
						title="Verify BACP Registered Member 394660"
					>
						<img 
							src="/shelley_liu_bacp.png" 
							alt="BACP Registered Member 394660 - Shelley Liu" 
							class="h-28 sm:h-32 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
							loading="lazy"
						/>
					</a>
				</div>
			</div>

			<!-- Navigation Links -->
			<div class="space-y-3">
				<h4 class="font-serif text-sm font-medium text-white tracking-wide">Quick Navigation</h4>
				<ul class="space-y-2 text-stone-400">
					<li><a href="/#about" class="hover:text-[#5ad01f] transition-colors">About Me</a></li>
					<li><a href="/#services" class="hover:text-[#5ad01f] transition-colors">Areas Of Support</a></li>
					<li><a href="/#how-it-works" class="hover:text-[#5ad01f] transition-colors">How It Works</a></li>
					<li><a href="/#fees-faq" class="hover:text-[#5ad01f] transition-colors">Fees &amp; FAQs</a></li>
					<li><a href="/#contact" class="hover:text-[#5ad01f] transition-colors">Contact</a></li>
					<li><a href="/#crisis-support" class="text-amber-400 hover:text-amber-300 font-medium transition-colors">Emergency &amp; Crisis Support</a></li>
				</ul>
			</div>

		</div>

		<!-- Bottom Copyright -->
		<div class="pt-6 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-stone-500">
			<div>
				© {currentYear} Shelley Liu Counselling Service. All rights reserved.
			</div>
			<div class="flex items-center gap-3">
				<a href="/privacy-policy" class="hover:text-stone-300 transition-colors underline-offset-2 hover:underline">Privacy Policy</a>
			</div>
		</div>

	</div>
</footer>
