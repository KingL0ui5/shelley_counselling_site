---
const navLinks = [
	{ name: 'About Me', href: '#about' },
	{ name: 'Services', href: '#services' },
	{ name: 'How It Works', href: '#how-it-works' },
	{ name: 'Fees & FAQ', href: '#fees-faq' },
	{ name: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 bg-[#faf9f6]/95 backdrop-blur-md border-b border-stone-200/80 transition-all duration-300">
	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-20">
			
			<!-- Brand Logo -->
			<a href="/" class="group flex flex-col">
				<span class="font-serif text-2xl font-semibold tracking-tight text-emerald-950 group-hover:text-emerald-800 transition-colors">
					Shelley Liu
				</span>
				<span class="text-[11px] font-medium tracking-wider uppercase text-emerald-800 flex items-center gap-1.5">
					<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
					Counselling Service • MBACP
				</span>
			</a>

			<!-- Desktop Navigation -->
			<nav class="hidden md:flex items-center space-x-8">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						class="text-sm font-medium text-stone-600 hover:text-emerald-950 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#5ad01f] hover:after:w-full after:transition-all after:duration-300"
					>
						{link.name}
					</a>
				))}
				<a 
					href="#contact" 
					class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-white bg-emerald-900 hover:bg-emerald-950 rounded-full shadow-sm hover:shadow transition-all duration-200"
				>
					Get in Touch
				</a>
			</nav>

			<!-- Mobile menu button -->
			<div class="flex md:hidden">
				<button 
					type="button" 
					id="mobile-menu-btn" 
					class="p-2 rounded-lg text-stone-700 hover:text-emerald-950 hover:bg-stone-200/60 focus:outline-none"
					aria-label="Toggle menu"
				>
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile menu container -->
	<div id="mobile-menu" class="hidden md:hidden border-b border-stone-200 bg-[#faf9f6] px-4 pt-2 pb-6 space-y-3">
		{navLinks.map((link) => (
			<a 
				href={link.href} 
				class="block text-base font-medium text-stone-700 hover:text-emerald-900 hover:bg-stone-200/50 px-3 py-2 rounded-lg transition-colors mobile-nav-link"
			>
				{link.name}
			</a>
		))}
		<div class="pt-2">
			<a 
				href="#contact" 
				class="block w-full text-center px-4 py-2.5 text-xs font-semibold uppercase tracking-wider text-white bg-emerald-900 hover:bg-emerald-950 rounded-full shadow-sm"
			>
				Get in Touch
			</a>
		</div>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('mobile-menu-btn');
	const mobileMenu = document.getElementById('mobile-menu');
	const mobileLinks = document.querySelectorAll('.mobile-nav-link');

	if (menuBtn && mobileMenu) {
		menuBtn.addEventListener('click', () => {
			mobileMenu.classList.toggle('hidden');
		});

		mobileLinks.forEach(link => {
			link.addEventListener('click', () => {
				mobileMenu.classList.add('hidden');
			});
		});
	}
</script>
