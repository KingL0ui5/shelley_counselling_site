---
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28 bg-gradient-to-b from-stone-100/70 via-[#faf9f6] to-white">
	<!-- Background subtle ambient circles with soft botanical tint -->
	<div class="absolute top-10 right-10 w-96 h-96 bg-[#5ad01f]/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
	<div class="absolute bottom-5 left-10 w-80 h-80 bg-emerald-100/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			
			<!-- Left / Main Text Column -->
			<div class="lg:col-span-7 space-y-6 text-left">
				
				<!-- Badge with Spring Green Accent -->
				<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50/90 border border-emerald-200 text-emerald-900 text-xs font-semibold tracking-wide uppercase shadow-sm">
					<span class="w-2 h-2 rounded-full bg-[#5ad01f] ring-4 ring-[#5ad01f]/20 animate-pulse"></span>
					MBACP Registered Counsellor • Online Therapy UK-Wide
				</div>

				<h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-stone-900 leading-[1.15]">
					Shelley Liu <br class="hidden sm:inline" />
					<span class="italic text-emerald-900">Counselling Service</span>
				</h1>

				<p class="text-lg sm:text-xl text-stone-700 leading-relaxed font-light max-w-2xl">
					A warm, confidential, and collaborative environment to help you explore life’s difficulties, overcome feelings of being stuck, and discover lasting emotional resilience from the comfort of your own space.
				</p>

				<!-- Format badges with green highlights -->
				<div class="flex flex-wrap gap-y-2 gap-x-4 text-xs sm:text-sm text-stone-600 pt-1">
					<span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-stone-200/80 shadow-xs">
						<svg class="w-4 h-4 text-[#5ad01f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
						Online &amp; Video Sessions Available UK-Wide
					</span>
					<span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full border border-stone-200/80 shadow-xs">
						<svg class="w-4 h-4 text-[#5ad01f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
						</svg>
						Confidential &amp; Secure Platform
					</span>
				</div>

				<!-- Actions -->
				<div class="pt-4 flex flex-col sm:flex-row gap-4">
					<a 
						href="#contact" 
						class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-semibold tracking-wide text-white bg-emerald-900 hover:bg-emerald-950 rounded-full shadow-md hover:shadow-lg transition-all duration-200 group"
					>
						Book an Initial Consultation
						<svg class="ml-2 w-4 h-4 text-[#5ad01f] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>
					<a 
						href="#about" 
						class="inline-flex items-center justify-center px-7 py-3.5 text-sm font-medium text-stone-700 bg-white hover:bg-stone-100 border border-stone-300 rounded-full shadow-sm transition-all duration-200"
					>
						About Me
					</a>
				</div>
			</div>

			<!-- Right Column / Featured Card with Therapy Highlights -->
			<div class="lg:col-span-5">
				<div class="relative bg-white/95 backdrop-blur-sm border border-stone-200 rounded-3xl p-8 shadow-xl shadow-stone-200/50 space-y-6">
					
					<div class="flex items-center justify-between border-b border-stone-100 pb-5">
						<div>
							<h2 class="font-serif text-2xl font-normal text-stone-900">Shelley Liu</h2>
							<p class="text-xs font-semibold text-emerald-800 tracking-wider uppercase mt-0.5">BACP Registered Counsellor</p>
						</div>
						<div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-800">
							<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
							</svg>
						</div>
					</div>

					<div>
						My priority is ensuring you feel genuinely heard and understood in a safe space where you can explore your thoughts and emotions freely, at your own pace. 
					</div>
					


					<ul class="space-y-3 text-sm text-stone-600">
						<li class="flex items-start gap-2.5">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f] shrink-0 mt-2"></span>
							<span><strong>Person-Centred &amp; Integrative</strong> counselling tailored to your needs</span>
						</li>
						<li class="flex items-start gap-2.5">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f] shrink-0 mt-2"></span>
							<span>Over 5 years clinical experience with <strong>NHS Talking Therapies &amp; MIND</strong></span>
						</li>
						<li class="flex items-start gap-2.5">
							<span class="w-2 h-2 rounded-full bg-[#5ad01f] shrink-0 mt-2"></span>
							<span>Specialist understanding of <strong>high-pressure workplace stress &amp; burnout</strong></span>
						</li>
					</ul>

					<div class="pt-3 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
						<span>Strict BACP Ethical Framework</span>
						<span class="text-emerald-800 font-semibold flex items-center gap-1">
							<span class="w-1.5 h-1.5 rounded-full bg-[#5ad01f]"></span>
							100% Confidential
						</span>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>
