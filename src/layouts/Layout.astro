---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Shelley Liu Counselling | MBACP Registered Online Counsellor',
	description = 'Professional, confidential, person-centred online counselling service with Shelley Liu (MBACP). Available remotely across the UK.'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#faf9f6" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Shelley Liu - MBACP Registered Online Counsellor" />
		<meta property="og:site_name" content="Shelley Liu Counselling" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Google Fonts: Lora (Serif) & Plus Jakarta Sans (Sans) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

		<Analytics />
	</head>
	<body class="bg-[#faf9f6] text-stone-800 antialiased flex flex-col min-h-screen selection:bg-[#5ad01f]/20 selection:text-emerald-950 overflow-x-hidden">
		<slot />
	</body>
</html>
