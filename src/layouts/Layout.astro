---
import '../styles/global.css';

export interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Shelley Liu Counselling | MBACP Registered Online Counsellor',
	description = 'Professional, confidential, person-centred online counselling service with Shelley Liu (MBACP). Available remotely across the UK.'
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />

		<!-- Google Fonts: Lora (Serif) & Plus Jakarta Sans (Sans) -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#faf9f6] text-stone-800 antialiased flex flex-col min-h-screen selection:bg-[#5ad01f]/20 selection:text-emerald-950">
		<slot />
	</body>
</html>
